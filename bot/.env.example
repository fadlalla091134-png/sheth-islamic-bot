# =========================================================
# بوت شيث (Sheth WhatsApp Bot) - Environment Configuration
# =========================================================

# WhatsApp phone number to pair (digits only, with country code, no + or spaces)
# Example: 249905358205
BOT_NUMBER=249905358205

# Bot Owner WhatsApp number (digits only, full admin control)
OWNER_NUMBER=249905358205

# Owner display name shown in .menu and .owner
OWNER_NAME=شيث

# Command prefix (default: .)
PREFIX=.

# Google Gemini API Key (for @google/genai gemini-2.5-flash)
GEMINI_API_KEY=

# Firebase Service Account JSON (either minified single-line JSON or Base64-encoded JSON)
FIREBASE_SERVICE_ACCOUNT=

# Optional default cover image URL for .menu (can also be updated anytime via .setbotimg)
BOT_IMAGE_URL=

# Express Keep-Alive HTTP Server Port
PORT=3000
